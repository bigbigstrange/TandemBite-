:host{display:block;color:#4A392E;font-family:-apple-system,BlinkMacSystemFont,'Microsoft YaHei',sans-serif}.ring-layout{display:flex;gap:28rpx;align-items:center;margin:20rpx 0 28rpx}.ring-figure{position:relative;width:310rpx;height:310rpx;flex-shrink:0}.ring-canvas{width:100%;height:100%;display:block}.ring-center{position:absolute;inset:0;display:flex;justify-content:center;align-items:center;flex-direction:column;pointer-events:none}.ring-label{font-size:23rpx;color:#7E6C59;max-width:200rpx;line-height:1.5;text-align:center}.ring-money{font-size:38rpx;font-weight:500;letter-spacing:-1rpx;font-variant-numeric:tabular-nums;margin-top:5rpx}.ring-aside{flex:1;min-width:0;color:#7E6C59;font-size:24rpx;line-height:1.8}.ring-aside text{display:block}.ring-title{font-size:31rpx;color:#4A392E;margin-bottom:6rpx}.ring-row{width:100%;box-sizing:border-box;display:flex;align-items:center;gap:16rpx;text-align:left;min-height:104rpx;padding:20rpx 4rpx;margin:0;background:transparent;color:#4A392E;border:0;border-bottom:1rpx solid #E9DDCA;border-radius:0;font-size:27rpx;line-height:1.5;transition:background .18s ease}.ring-row::after{border:0}.ring-row.selected{background:#E7EAD6;border-radius:18rpx}.ring-swatch{height:17rpx;width:17rpx;border-radius:50%;flex-shrink:0}.ring-category{flex:1;min-width:0}.ring-percent{font-size:22rpx;color:#7E6C59;min-width:72rpx;text-align:right}.ring-amount{min-width:160rpx;text-align:right;font-variant-numeric:tabular-nums;font-weight:500;font-size:27rpx}.ring-fallback{position:absolute;inset:35rpx;border:20rpx solid #E9DDCA;border-radius:50%}@media(prefers-reduced-motion:reduce){.ring-row{transition:none}}
