<view class="container tb-unified tb-screen-Settings">
  <!-- 页面头部 -->
  <view class="page-header">
    <image class="header-mascot" bindtap="greetDog" aria-label="和伴食小狗打招呼" src="/images/tandem/brand.jpg" mode="aspectFit"></image>
    <view class="header-info">
      <text class="header-title">{{appName}}</text>
      <text class="header-subtitle" wx:if="{{isBound}}">和{{partnerName}}的专属小厨房</text>
      <text class="header-subtitle" wx:else>好好吃饭，慢慢记账。🐾</text>
    </view>
  </view>

  <!-- 账号信息 -->
  <view class="settings-section">
    <view class="section-title">账号信息</view>
    <view class="settings-card">
      <view class="settings-item" bindtap="openEditProfile">
        <image class="item-avatar" src="{{userAvatar || '/images/tandem/brand.jpg'}}" mode="aspectFill"></image>
        <view class="item-content">
          <text class="item-label">我的身份</text>
          <text class="item-name">{{userName}}</text>
        </view>
        <text class="item-arrow">></text>
      </view>
      <view class="settings-item" bindtap="goToBind">
        <view class="item-icon"><image class="tb-line-icon" src="/images/tandem/icons/heart-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
        <text class="item-label">我的另一半</text>
        <view class="item-right" wx:if="{{isBound}}">
          <image class="partner-mini-avatar" src="{{partnerAvatar || '/images/tandem/brand.jpg'}}" mode="aspectFill"></image>
          <text class="item-value">{{partnerName}}</text>
        </view>
        <text wx:else class="item-value unbound">未绑定</text>
        <text class="item-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="settings-section"><view class="settings-card"><view class="settings-item" bindtap="goKitchen"><view class="item-icon"><image class="tb-line-icon" src="/images/tandem/icons/cooking-pot-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view><text class="item-label">我们的小厨房</text><text class="item-arrow">›</text></view><view class="settings-item" bindtap="goLedger"><view class="item-icon"><image class="tb-line-icon" src="/images/tandem/icons/notebook-pen-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view><text class="item-label">生活账本 · 日期筛选 · 导出</text><text class="item-arrow">›</text></view></view></view>
  <view class="settings-section">
    <view class="section-title">数据统计</view>
    <view class="settings-card">
      <view class="settings-item">
        <view class="item-icon"><image class="tb-line-icon" src="/images/tandem/icons/utensils-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
        <text class="item-label">菜品总数</text>
        <text class="item-value">{{dishCount}} 道</text>
      </view>
      <view class="settings-item">
        <view class="item-icon"><image class="tb-line-icon" src="/images/tandem/icons/clipboard-list-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
        <text class="item-label">点菜次数</text>
        <text class="item-value">{{orderCount}} 次</text>
      </view>
    </view>
  </view>

  <!-- 消息通知 -->
  <view class="settings-section">
    <view class="section-title">消息通知</view>
    <view class="settings-card">
      <view class="settings-item" bindtap="requestNotifyPermission">
        <view class="item-icon"><image class="tb-line-icon" src="/images/tandem/icons/bell-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
        <text class="item-label">订阅消息</text>
        <text class="item-arrow">></text>
      </view>
    </view>
  </view>


  <!-- 关于 -->
  <view class="settings-section">
    <view class="section-title">关于</view>
    <view class="settings-card">
      <view class="settings-item">
        <view class="item-icon"><image class="tb-line-icon" src="/images/tandem/icons/smartphone-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
        <text class="item-label">版本号</text>
        <text class="item-value">v2.3.1</text>
      </view>
      <view class="settings-item" bindtap="showLoadDiagnostics"><view class="item-icon"><image class="tb-line-icon" src="/images/tandem/icons/clock-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view><text class="item-label">加载速度诊断</text><text class="item-arrow">></text></view>
      <button class="settings-item contact-btn" bindtap="showAbout">
        <view class="item-icon"><image class="tb-line-icon" src="/images/tandem/icons/message-circle-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
        <text class="item-label">关于伴食与开源许可</text>
        <text class="item-arrow">></text>
      </button>
    </view>
  </view>

  <!-- 底部版权 -->
  <view class="footer">
    <text class="footer-text" wx:if="{{isBound}}">Made with 💚 for {{partnerName}}</text>
    <text class="footer-text" wx:else>Made with 💚</text>
  </view>

  <!-- 编辑头像昵称弹窗 -->
  <view wx:if="{{showEditModal}}" class="modal-mask" catchtap="closeEditModal">
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">编辑个人信息</text>
      </view>
      <view class="modal-body">
        <!-- 头像选择 -->
        <view class="avatar-section">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="avatar-preview" src="{{tempAvatarUrl || userAvatar || '/images/tandem/brand.jpg'}}" mode="aspectFill"></image>
            <view class="avatar-edit-icon">📷</view>
          </button>
          <text class="avatar-hint">点击更换头像</text>
        </view>
        <!-- 昵称输入 -->
        <view class="nickname-section">
          <text class="nickname-label">昵称</text>
          <view class="nickname-input-wrap">
            <input
              class="nickname-input"
              type="nickname"
              placeholder="点击输入昵称"
              value="{{tempNickname}}"
              bindinput="onNicknameInput"
            />
          </view>
          <view class="nickname-tip">
            <view class="tip-icon"><image class="tb-line-icon" src="/images/tandem/icons/heart-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
            <text class="tip-text">点击输入框，键盘上方可选择微信昵称</text>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closeEditModal">取消</view>
        <view class="modal-btn confirm" bindtap="saveProfile">保存</view>
      </view>
    </view>
  </view>
</view>

<include src="../../templates/feedback.wxml"/>
