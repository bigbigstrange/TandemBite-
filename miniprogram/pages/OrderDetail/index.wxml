<view class="container tb-unified tb-screen-OrderDetail" wx:if="{{order}}">
  <!-- 头部信息 -->
  <view class="header-card">
    <view class="header-row">
      <text class="header-date">{{order.dateText}}</text>
      <text class="header-time">{{order.timeText}}</text>
    </view>
    <view class="header-creator">{{order.creatorName}}点的菜</view>
  </view>

  <!-- 菜品列表 -->
  <view class="section">
    <view class="section-title">
      <view class="section-icon"><image class="tb-line-icon" src="/images/tandem/icons/utensils-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
      <text>菜品清单</text>
      <text class="dish-total">共{{order.dishes.length}}道</text>
    </view>
    <view class="dish-list">
      <view class="dish-item" wx:for="{{order.dishes}}" wx:key="_id">
        <image lazy-load class="dish-image" wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"></image>
        <image lazy-load class="dish-image" wx:else src="/images/tandem/dish-placeholder.png" mode="aspectFill"></image>
        <text class="dish-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section" wx:if="{{order.remark}}">
    <view class="section-title">
      <view class="section-icon"><image class="tb-line-icon" src="/images/tandem/icons/message-circle-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
      <text>备注</text>
    </view>
    <view class="remark-card">
      <text class="remark-text">{{order.remark}}</text>
    </view>
  </view>

  <!-- 成品照片 -->
  <view class="section photo-section">
    <view class="section-title">
      <view class="section-icon"><image class="tb-line-icon" src="/images/tandem/icons/camera-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
      <text>成品照片</text>
      <text class="photo-tip" wx:if="{{!order.finishedPhoto}}">记录美味时刻</text>
    </view>
    <!-- 已有照片 -->
    <view class="photo-preview" wx:if="{{order.finishedPhoto}}">
      <image class="finished-photo" src="{{order.finishedPhoto}}" mode="aspectFill" bindtap="previewPhoto"></image>
      <view class="photo-actions" wx:if="{{!readOnly}}">
        <view class="photo-action-btn" bindtap="changePhoto">
          <text class="action-icon">🔄</text>
          <text>更换照片</text>
        </view>
        <view class="photo-action-btn delete" bindtap="deletePhoto">
          <text class="action-icon">🗑️</text>
          <text>删除</text>
        </view>
      </view>
    </view>
    <!-- 未上传照片 -->
    <view class="photo-upload" wx:elif="{{!readOnly}}" bindtap="uploadPhoto">
      <view class="upload-icon">📷</view>
      <text class="upload-text">拍一张做好的菜</text>
      <text class="upload-hint">点击上传照片</text>
    </view>
  </view>

  <!-- 再来一单按钮 -->
  <view class="tb-page-actions">
    <button class="tb-btn" bindtap="completeMeal" wx:if="{{!order.completed && !readOnly}}">完成做饭</button>
    <view class="tb-muted" wx:elif="{{order.completed}}">这顿饭已经完成，辛苦啦</view>
    <button class="tb-btn tb-btn-light" bindtap="recordExpense">记录这顿饭的食材花销</button>
  </view>
  <view class="reorder-btn" wx:if="{{!readOnly}}" bindtap="reorder">
    <text class="reorder-icon">🔄</text>
    <text>再来一单</text>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
<bind-guard />

<include src="../../templates/feedback.wxml"/>
