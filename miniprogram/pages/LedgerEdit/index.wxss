.tb-money-input{height:130rpx;font-size:68rpx;color:var(--text-primary);border-bottom:1rpx solid var(--border-color);margin-bottom:30rpx}.tb-category-grid{display:flex;flex-wrap:wrap;margin:20rpx -6rpx}.tb-category-grid button{width:calc(25% - 12rpx);margin:6rpx;font-size:23rpx;padding:18rpx 0;background:var(--card-bg);border:1rpx solid var(--border-color);border-radius:22rpx;line-height:1.7}.tb-category-grid button.selected{background:var(--primary-light);border-color:var(--primary-color)}.tb-field-label{font-size:25rpx;color:var(--text-secondary);margin:32rpx 0 15rpx}.tb-input{background:var(--card-bg);border:1rpx solid var(--border-color);border-radius:24rpx;padding:23rpx;font-size:30rpx;min-height:40rpx}.tb-btn{margin-top:40rpx}
