<view class="container tb-unified tb-screen-DishDetail">
  <!-- 菜品图片 -->
  <view class="dish-image-wrapper" bindtap="previewPhoto">
    <image lazy-load class="dish-image" wx:if="{{dish.imageUrl || previewImageUrl}}" src="{{dish.imageUrl || previewImageUrl}}" mode="widthFix"></image>
    <image lazy-load class="dish-image" wx:else src="/images/tandem/dish-placeholder.png" mode="widthFix"></image>
  </view>

  <!-- 菜品信息卡片 -->
  <view class="dish-info-card">
    <view class="dish-name">{{dish.name}}</view>
    <button class="tb-btn tb-btn-light" bindtap="toggleFavorite"><image class="tb-line-icon" src="/images/tandem/icons/{{dish.favorite ? 'star-filled' : 'star'}}-primary.png" style="width:31rpx;height:31rpx" mode="aspectFit" aria-hidden="true"/> {{dish.favorite ? '已加入共同收藏' : '收藏这道菜'}}</button>

    <view class="info-row">
      <view class="info-icon"><image class="tb-line-icon" src="/images/tandem/icons/user-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
      <text class="info-label">添加者</text>
      <text class="info-value">{{creatorName}}</text>
    </view>

    <view class="info-row">
      <view class="info-icon"><image class="tb-line-icon" src="/images/tandem/icons/calendar-days-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
      <text class="info-label">添加时间</text>
      <text class="info-value">{{dateText}}</text>
    </view>

    <view class="info-row" wx:if="{{dish.description || dish.desc}}">
      <view class="info-icon"><image class="tb-line-icon" src="/images/tandem/icons/notebook-pen-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
      <text class="info-label">备注</text>
      <text class="info-value">{{dish.description || dish.desc}}</text>
    </view>
  </view>

  <!-- 菜谱区 -->
  <view class="recipe-card" wx:if="{{dish.ingredients || dish.steps}}">
    <view class="recipe-header">
      <view class="recipe-title-wrap">
        <text class="recipe-title">菜谱</text>
      </view>
      <view class="recipe-edit-chip" wx:if="{{!readOnly}}" bindtap="editRecipeManual">
        <text>✏️ 编辑</text>
      </view>
    </view>

    <view class="recipe-meta" wx:if="{{dish.cookTime || dish.difficulty}}">
      <text class="meta-item" wx:if="{{dish.cookTime}}">⏱ {{dish.cookTime}}</text>
      <text class="meta-item" wx:if="{{dish.difficulty}}">🌶 {{dish.difficulty}}</text>
    </view>

    <view class="recipe-section" wx:if="{{dish.ingredients}}">
      <view class="recipe-section-title">🥬 食材</view>
      <view class="recipe-section-body">{{dish.ingredients}}</view>
    </view>

    <view class="recipe-section" wx:if="{{dish.steps}}">
      <view class="recipe-section-title">👩‍🍳 做法</view>
      <view class="recipe-section-body">{{dish.steps}}</view>
    </view>
  </view>

  <!-- 没有菜谱：空状态卡片 -->
  <view class="recipe-card recipe-empty-card" wx:else>
    <view class="recipe-header">
      <view class="recipe-title-wrap">
        <text class="recipe-title">菜谱</text>
      </view>
    </view>
    <view class="empty-body">
      <view class="empty-icon"><image class="tb-line-icon" src="/images/tandem/icons/notebook-pen-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/></view>
      <text class="empty-title">还没有菜谱</text>
      <text class="empty-hint">写一份做法，下次做更方便</text>
    </view>
    <view class="empty-actions" wx:if="{{!readOnly}}">
      <view class="empty-action" bindtap="editRecipeManual">
        <text>写菜谱</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons" wx:if="{{!readOnly}}">
    <view class="btn-edit" bindtap="editDish">
      <text>编辑菜品</text>
    </view>
    <view class="btn-delete" bindtap="deleteDish">
      <text>删除菜品</text>
    </view>
  </view>
</view>
<bind-guard />

<include src="../../templates/feedback.wxml"/>
