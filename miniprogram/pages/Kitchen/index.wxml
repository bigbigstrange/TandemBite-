<view class="tb-page tb-unified tb-screen-Kitchen">
  <view class="kitchen-banner"><view><view class="tb-muted">烟火气里，都是小幸福。</view><view class="tb-title">{{kitchenName}}</view></view><button class="kitchen-dog" bindtap="greetDog" aria-label="和伴食小狗打招呼"><image src="/images/tandem/dog-snack.png" mode="aspectFit"/></button></view>
  <view class="tb-error" wx:if="{{error}}">{{error}}<button class="tb-text-btn" bindtap="load">重新加载</button></view>
  <view class="tb-skeleton" wx:if="{{loading && !ready}}"><view/><view/><view/></view>
  <block wx:if="{{ready}}">
    <view class="tb-card kitchen-today"><view class="tb-between"><view class="tb-heading">今天的餐单</view><text class="kitchen-status">{{todayOrder ? (todayOrder.completed ? '已完成' : '待开饭') : '等你来安排'}}</text></view><view class="kitchen-meal-tags" wx:if="{{todayOrder}}" data-id="{{todayOrder._id}}" bindtap="orderDetail"><text wx:for="{{todayOrder.dishes}}" wx:key="_id">{{item.name}}</text></view><view class="tb-muted" wx:else>一顿热饭，给今天添一点幸福。</view><button class="tb-btn tb-full" bindtap="goOrder"><image class="tb-line-icon" src="/images/tandem/icons/utensils-cream.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/> 去点菜，安排一顿热饭</button></view>
    <view class="tb-between kitchen-section"><text class="tb-heading">积攒的拿手菜</text><button class="tb-text-btn" bindtap="goDishes">全部{{dishCount}}道 <image class="tb-line-icon" src="/images/tandem/icons/chevron-right-primary.png" style="width:25rpx;height:25rpx" mode="aspectFit" aria-hidden="true"/></button></view>
    <view class="kitchen-dishes" wx:if="{{recentDishes.length}}"><view wx:for="{{recentDishes}}" wx:key="_id" class="kitchen-dish" data-id="{{item._id}}" bindtap="dishDetail"><view class="kitchen-cover"><image lazy-load src="{{item.imageUrl || '/images/tandem/dish-placeholder.png'}}" mode="aspectFill"/></view><text>{{item.name}}</text></view><button class="kitchen-add-tile" bindtap="addDish"><image class="tb-line-icon" src="/images/tandem/icons/plus-primary.png" style="width:46rpx;height:46rpx" mode="aspectFit" aria-hidden="true"/><text>再添一道拿手菜</text></button></view>
    <view class="tb-card kitchen-empty" wx:else bindtap="addDish"><image src="/images/tandem/dog-food.png" mode="aspectFit"/><view><view>先添一道喜欢的菜吧</view><text class="tb-muted">照片可以拍照或从相册上传 <image class="tb-line-icon" src="/images/tandem/icons/chevron-right-primary.png" style="width:24rpx;height:24rpx" mode="aspectFit" aria-hidden="true"/></text></view></view>
    <view class="tb-actions kitchen-actions"><button class="tb-btn tb-btn-light" bindtap="goDishes"><image class="tb-line-icon" src="/images/tandem/icons/book-open-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/> 管理菜品</button><button class="tb-btn tb-btn-light" bindtap="goHistory"><image class="tb-line-icon" src="/images/tandem/icons/notebook-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/> 做饭记录</button></view>
    <view class="tb-heading kitchen-section">最近的烟火气</view><view class="tb-card" wx:if="{{recentOrder}}" data-id="{{recentOrder._id}}" bindtap="orderDetail"><view class="kitchen-recent" wx:for="{{recentOrder.dishes}}" wx:key="_id">{{item.name}}</view><view class="tb-muted">{{recentOrder.completed ? '把简单的一餐，也认真做好。' : '餐单已存好，记得去记录美味。'}} <image class="tb-line-icon" src="/images/tandem/icons/chevron-right-primary.png" style="width:24rpx;height:24rpx" mode="aspectFit" aria-hidden="true"/></view></view><view class="tb-muted" wx:else>把第一顿热饭，留在这里。🐾</view>
  </block>
</view>
<include src="../../templates/feedback.wxml"/>
