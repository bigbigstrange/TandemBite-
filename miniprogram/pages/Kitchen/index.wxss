.kitchen-banner{display:flex;align-items:center;gap:18rpx;margin:0 0 20rpx;padding:10rpx 0 12rpx}.kitchen-banner>view{flex:1;min-width:0}.kitchen-banner .tb-title{margin-top:10rpx;font-size:47rpx}.kitchen-dog{padding:0;margin:0;line-height:1;flex-shrink:0;transform:rotate(4deg)}.kitchen-dog image{display:block;width:160rpx;height:160rpx}.kitchen-section{margin:28rpx 0 8rpx}.kitchen-today{margin-top:0!important}.kitchen-today .tb-btn{margin-bottom:0!important}.kitchen-today>.tb-muted{margin-top:20rpx}.kitchen-status{font-size:22rpx;color:#637556;background:#E7EAD6;padding:7rpx 14rpx;border-radius:20rpx;flex-shrink:0}.kitchen-meal-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin:22rpx 0}.kitchen-meal-tags text{background:#E7EAD6;color:#536447;border-radius:16rpx;padding:8rpx 15rpx;font-size:25rpx}.kitchen-dishes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:25rpx 22rpx;margin:16rpx 0 25rpx}.kitchen-dish{min-width:0;transition:transform .16s ease}.kitchen-dish:active{transform:scale(.98)}.kitchen-cover{position:relative;padding-top:75%;border-radius:29rpx;background:#EEE6D8;overflow:hidden}.kitchen-cover image{position:absolute;top:0;left:0;width:100%;height:100%}.kitchen-dish>text{display:block;font-size:29rpx;margin-top:12rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.kitchen-add-tile{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:13rpx;background:#E7EAD6;border:1rpx dashed #C4CEB2;border-radius:28rpx;color:#637556;font-size:24rpx;margin:0;min-height:215rpx;padding:20rpx}.kitchen-empty{display:flex;align-items:center;gap:20rpx}.kitchen-empty image{width:110rpx;height:110rpx;flex-shrink:0}.kitchen-recent{font-size:29rpx;margin-bottom:9rpx}.kitchen-actions button{display:flex!important;align-items:center;justify-content:center;gap:8rpx}
