<view class="tb-page tb-unified tb-screen-Ledger">
  <view class="tb-between"><view class="tb-title">生活账本</view><button class="tb-chip" bindtap="openFilter"><image class="tb-line-icon" src="/images/tandem/icons/sliders-horizontal-primary.png" style="width:29rpx;height:29rpx" mode="aspectFit" aria-hidden="true"/> 筛选</button></view>
  <view class="tb-muted">{{periodLabel}} · {{filtersApplied ? '所选分类支出' : '生活的一笔一笔'}}</view>
  <view class="tb-card tb-mint tb-enter">
    <view class="tb-between"><text class="tb-muted">{{deleted ? '正常账目汇总' : (filtersApplied ? '筛选支出合计' : '本月支出')}}</text><picker wx:if="{{mode === 'month'}}" mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><text>{{month}} ⌄</text></picker><button wx:else class="tb-text-btn" bindtap="openFilter">更改日期 ›</button></view>
    <view class="tb-big-money">¥ {{loading ? '…' : expenseText}}</view>
    <view class="tb-summary-grid" wx:if="{{!filtersApplied}}"><view>收入<text>¥ {{loading ? '…' : incomeText}}</text></view><view>收支差额<text>¥ {{loading ? '…' : netText}}</text></view></view>
    <view class="tb-muted" wx:else>{{filterLabel}} · 不包含收入</view>
  </view>
  <view class="tb-tabs"><button wx:for="{{tabs}}" wx:key="*this" class="{{tab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="changeTab">{{item}}</button></view>
  <button class="tb-btn tb-full" bindtap="addEntry"><image class="tb-line-icon" src="/images/tandem/icons/plus-cream.png" style="width:32rpx;height:32rpx" mode="aspectFit" aria-hidden="true"/> 记一笔</button>
  <view class="tb-between"><text class="tb-muted">{{deleted ? '最近删除 · 按当前日期查看' : (filtersApplied ? '支出明细' : '收支明细')}}</text><button wx:if="{{!deleted}}" class="tb-text-btn" bindtap="exportCSV">导出当前明细</button></view>
  <view class="tb-error" wx:if="{{error}}">{{error}}<button class="tb-text-btn" bindtap="onShow">重新加载</button></view>
  <block wx:if="{{tab === '明细'}}">
    <view class="tb-skeleton" wx:if="{{loading && !entries.length}}"><view/><view/></view>
    <block wx:for="{{entries}}" wx:key="_id"><view class="ledger-date" wx:if="{{item.showDate}}">{{item.dateKey}}</view><view class="tb-entry {{item.type}}" data-id="{{item._id}}" bindtap="editEntry"><view class="tb-entry-icon"><image class="tb-line-icon" src="/images/tandem/icons/{{item.icon}}-primary.png" style="width:36rpx;height:36rpx" mode="aspectFit" aria-hidden="true"/></view><view class="tb-entry-main"><view>{{item.note || item.category}}</view><view class="tb-muted">{{item.category}} · {{item.creatorLabel}}记录</view></view><text class="tb-entry-money">{{item.type === 'income' ? '+' : '−'}}{{item.amountText}}</text></view></block>
    <view class="tb-empty" wx:if="{{!entries.length && !loading && !error}}"><image src="/images/tandem/dog-food.png" mode="aspectFit"/><text>{{deleted ? '这段时间没有删除的账目' : '这段日子，还没有符合条件的小账'}}</text></view>
    <button wx:if="{{hasMore}}" class="tb-text-btn" bindtap="loadMore">{{loading ? '加载中…' : '加载更多'}}</button>
  </block>
  <block wx:else><view class="ledger-chart" wx:if="{{!loading && !error}}"><ledger-ring id="ledger-ring" items="{{categories}}"/></view><view class="tb-caption" wx:if="{{loading}}">正在整理分类支出…</view><view class="tb-card"><view class="tb-heading">按记账人查看支出</view><view class="tb-between tb-stat" wx:for="{{people}}" wx:key="id"><text>{{item.name}}</text><text>¥ {{item.amount}}</text></view><view class="tb-muted">按创建人统计，不代表实际付款人。</view></view></block>
  <button wx:if="{{filtersApplied}}" class="tb-text-btn tb-full" bindtap="clearFilter">恢复原来的月度收支统计</button>
  <button class="tb-text-btn tb-full" bindtap="toggleDeleted">{{deleted ? '返回正常明细' : '最近删除 · 可恢复'}}</button>
</view>
<view wx:if="{{showFilter}}" class="tb-filter-mask" catchtap="closeFilter"><view class="tb-filter-sheet" catchtap="preventClose"><view class="tb-between"><view class="tb-heading">想看看哪段小日子？</view><button class="tb-text-btn" bindtap="closeFilter">关闭</button></view><view class="tb-tabs"><button class="{{draftMode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="draftMode">按月统计</button><button class="{{draftMode === 'range' ? 'active' : ''}}" data-mode="range" bindtap="draftMode">自定义日期</button></view><picker wx:if="{{draftMode === 'month'}}" mode="date" fields="month" value="{{draftMonth}}" data-field="draftMonth" bindchange="draftDate"><view class="tb-date-cell">{{draftMonth}} ⌄</view></picker><view class="tb-date-grid" wx:else><picker mode="date" value="{{draftStart}}" data-field="draftStart" bindchange="draftDate"><view class="tb-date-cell"><text>开始日期</text>{{draftStart}} ⌄</view></picker><picker mode="date" value="{{draftEnd}}" data-field="draftEnd" bindchange="draftDate"><view class="tb-date-cell"><text>结束日期</text>{{draftEnd}} ⌄</view></picker></view><view class="tb-between"><view class="tb-heading">支出分类</view><button class="tb-text-btn" bindtap="selectAll">{{allSelected ? '取消全选' : '全选'}}</button></view><view class="tb-filter-categories"><button wx:for="{{draftCategories}}" wx:key="name" class="{{item.selected ? 'selected' : ''}}" data-name="{{item.name}}" bindtap="toggleCategory"><image class="tb-line-icon" src="/images/tandem/icons/{{item.icon}}-primary.png" style="width:34rpx;height:34rpx" mode="aspectFit" aria-hidden="true"/>{{item.name}}</button></view><view class="tb-muted">起止日期都包含在内；分类筛选只统计支出。</view><view class="tb-error" wx:if="{{filterError}}">{{filterError}}</view><button class="tb-btn tb-full" bindtap="applyFilter" disabled="{{loading}}">查看支出明细</button></view></view>

<include src="../../templates/feedback.wxml"/>
