.tb-summary-grid{display:flex;border-top:1rpx solid #bdcfbd;padding-top:20rpx}.tb-summary-grid>view{width:50%;font-size:24rpx}.tb-summary-grid text{display:block;font-size:32rpx;margin-top:7rpx}.tb-entry{display:flex;gap:20rpx;align-items:center;padding:26rpx 0;border-bottom:1rpx solid var(--border-color)}.tb-entry-icon{width:76rpx;height:76rpx;border-radius:25rpx;background:var(--primary-light);display:flex;align-items:center;justify-content:center;font-size:34rpx;flex-shrink:0}.tb-entry-main{flex:1;min-width:0;word-break:break-all}.tb-entry-money{font-size:31rpx;white-space:nowrap}.tb-stat{margin:25rpx 0}.tb-track{height:12rpx;background:#ece4d7;border-radius:10rpx;overflow:hidden;margin-top:12rpx}.tb-track>view{height:100%;background:#6c9476;border-radius:10rpx}
.tb-filter-mask{position:fixed;inset:0;background:rgba(67,49,31,.35);z-index:100;display:flex;align-items:flex-end;padding:14rpx;box-sizing:border-box}.tb-filter-sheet{box-sizing:border-box;width:100%;max-height:94vh;overflow-y:auto;background:var(--bg-color);border-radius:48rpx;padding:30rpx 30rpx calc(35rpx + env(safe-area-inset-bottom));animation:tb-rise .23s ease}.tb-filter-sheet .tb-heading{font-size:32rpx}.tb-date-grid{display:flex;gap:16rpx}.tb-date-grid>picker{flex:1;min-width:0}.tb-date-cell{background:var(--card-bg);border:1rpx solid var(--border-color);padding:22rpx 15rpx;border-radius:22rpx;font-size:25rpx;margin:12rpx 0}.tb-date-cell text{display:block;color:var(--text-secondary);font-size:23rpx;margin-bottom:10rpx}.tb-filter-categories{display:flex;flex-wrap:wrap;gap:12rpx;margin:12rpx 0 22rpx}.tb-filter-categories button{box-sizing:border-box;width:calc(25% - 9rpx);background:var(--card-bg);border:1rpx solid var(--border-color);border-radius:23rpx;font-size:22rpx;line-height:1.7;padding:17rpx 2rpx;transition:background .16s ease,transform .16s ease}.tb-filter-categories button>text{display:block;font-size:33rpx;margin-bottom:5rpx}.tb-filter-categories button.selected{background:var(--primary-light);border-color:#78977b;color:var(--primary-dark)}
