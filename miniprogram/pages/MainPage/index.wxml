<view class="tb-page tb-unified tb-screen-MainPage">
  <view class="tb-between home-date-row"><text class="tb-muted">{{todayText}}</text><button class="tb-chip" bindtap="goKitchen"><image class="tb-line-icon" src="/images/tandem/icons/house-primary.png" style="width:26rpx;height:26rpx" mode="aspectFit" aria-hidden="true"/> 幸福小屋</button></view>
  <view class="tb-error" wx:if="{{error}}">{{error}}<button class="tb-text-btn" bindtap="onShow">点击重新加载</button></view>
  <view class="tb-hero"><view><view class="tb-title"><view>好好吃饭，</view><view>也记住小日子。</view></view><view class="tb-muted home-subtitle">努力建造我们的幸福小屋 🏡🌷🐾</view></view><button class="home-dog" bindtap="greetDog" aria-label="和伴食小狗打招呼"><image class="tb-brand" src="/images/tandem/brand.jpg" mode="aspectFit"/></button></view>
  <view class="home-shortcuts">
    <button class="home-order" bindtap="goToOrder"><view><view class="home-order-title">去点菜</view><text class="home-order-desc">今晚想吃点什么？</text></view><view class="home-order-arrow">安排一顿热饭 <image class="tb-line-icon" src="/images/tandem/icons/arrow-up-right-primary.png" style="width:30rpx;height:30rpx" mode="aspectFit" aria-hidden="true"/></view></button>
    <button class="home-shortcut" bindtap="addDish"><view class="home-shortcut-icon"><image class="tb-line-icon" src="/images/tandem/icons/cooking-pot-primary.png" style="width:37rpx;height:37rpx" mode="aspectFit" aria-hidden="true"/></view><view><text>添道菜</text><text class="home-shortcut-note">存下拿手的味道</text></view></button>
    <button class="home-shortcut" bindtap="addEntry"><view class="home-shortcut-icon peach"><image class="tb-line-icon" src="/images/tandem/icons/notebook-pen-primary.png" style="width:37rpx;height:37rpx" mode="aspectFit" aria-hidden="true"/></view><view><text>记一笔</text><text class="home-shortcut-note">记住生活的小事</text></view></button>
  </view>
  <block wx:if="{{ready}}">
    <view class="tb-between tb-section"><text class="tb-heading">今天的餐桌</text><button class="tb-text-btn" bindtap="goToHistory">做饭记录 <image class="tb-line-icon" src="/images/tandem/icons/chevron-right-primary.png" style="width:26rpx;height:26rpx" mode="aspectFit" aria-hidden="true"/></button></view>
    <view class="tb-card home-meal-card" wx:if="{{todayOrder}}" bindtap="goToTodayOrder">
      <view class="tb-between"><view class="home-meal-photos"><image lazy-load wx:for="{{todayPreviewDishes}}" wx:key="_id" src="{{item.imageUrl || '/images/tandem/dish-placeholder.png'}}" mode="aspectFill"/></view><text class="home-status">{{todayOrder.completed ? '已完成' : '待开饭'}}</text></view>
      <view class="home-meal-names"><text wx:for="{{todayPreviewDishes}}" wx:key="_id">{{index ? ' · ' : ''}}{{item.name}}</text><text wx:if="{{todayOrder.dishes.length > 3}}"> 等{{todayOrder.dishes.length}}道</text></view>
      <view class="tb-muted">{{todayOrder.completed ? '这一顿，辛苦啦。' : '一荤一素也好，一碗热汤也好。'}}</view>
    </view>
    <view class="tb-card tb-meal-empty" wx:else bindtap="goToOrder"><image src="/images/tandem/dog-food.png" mode="aspectFit"/><view><view>从一道喜欢的菜开始</view><view class="tb-muted">今天想吃什么？去厨房看看 <image class="tb-line-icon" src="/images/tandem/icons/chevron-right-primary.png" style="width:24rpx;height:24rpx" mode="aspectFit" aria-hidden="true"/></view></view></view>
    <view class="tb-card tb-mint home-budget" bindtap="goLedger"><view class="tb-between"><text class="tb-muted">这个月，生活花了</text><text class="tb-muted">{{month}}</text></view><view class="tb-big-money">¥ {{expenseText}}</view><view class="tb-between tb-summary-foot"><text>每一笔，都是认真生活。</text><text>查看账本 ↗</text></view></view>
    <button class="tb-text-btn tb-full home-pair-link" bindtap="goToBind"><image class="tb-line-icon" src="/images/tandem/icons/heart-primary.png" style="width:27rpx;height:27rpx" mode="aspectFit" aria-hidden="true"/> {{isBound ? '今天也有好好照顾彼此' : '想一起吃饭时，再邀请一个人'}} <image class="tb-line-icon" src="/images/tandem/icons/chevron-right-primary.png" style="width:24rpx;height:24rpx" mode="aspectFit" aria-hidden="true"/></button>
  </block>
  <view class="tb-skeleton" wx:if="{{loading && !ready}}"><view/><view/><view/></view>
  <view class="tb-caption" wx:if="{{loading}}">正在打开今天的小日子…</view>
</view>
<include src="../../templates/feedback.wxml"/>
