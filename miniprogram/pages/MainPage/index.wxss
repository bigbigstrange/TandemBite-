.home-date-row{margin:4rpx 0 10rpx}.tb-hero{gap:12rpx;padding:28rpx 0 38rpx}.tb-hero .tb-title{font-size:51rpx;line-height:1.48;letter-spacing:-1.5rpx;margin:0 0 14rpx}.home-subtitle{font-size:23rpx!important;line-height:1.8}.home-dog{padding:0;margin:0;min-width:0;flex-shrink:0;line-height:1;border-radius:36rpx;transform:rotate(4deg)}.tb-brand{display:block;width:235rpx;height:235rpx;border-radius:38rpx}.home-shortcuts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:184rpx 142rpx;gap:22rpx;margin:0 0 35rpx}.home-order{grid-column:span 2;display:flex;align-items:center;justify-content:space-between;text-align:left;padding:32rpx 35rpx!important;border-radius:40rpx;background:#E7EAD6;color:#637556;gap:12rpx;box-sizing:border-box;box-shadow:0 8rpx 25rpx #71512c0b;margin:0;border:1rpx solid #E9DDCA;line-height:1.5}.home-order-title{font-family:'TandemCheer','YouYuan',sans-serif;font-size:43rpx}.home-order-desc{font-size:24rpx;display:block;margin-top:5rpx}.home-order-arrow{display:flex;align-items:center;gap:6rpx;font-size:24rpx;white-space:nowrap}.home-shortcut{display:flex;align-items:center;text-align:left;padding:22rpx!important;gap:16rpx;border:1rpx solid #E9DDCA;border-radius:36rpx;background:#FFFDF7;line-height:1.6;margin:0;min-width:0;box-shadow:0 8rpx 25rpx #71512c09;font-size:31rpx}.home-shortcut-icon{display:flex;align-items:center;justify-content:center;width:67rpx;height:67rpx;border-radius:22rpx;background:#E7EAD6;flex-shrink:0}.home-shortcut-icon.peach{background:#F3DCC3}.home-shortcut-note{display:block;font-size:22rpx;color:#7E6C59;margin-top:2rpx}.tb-section{margin:20rpx 0 3rpx}.home-meal-card{margin-top:12rpx!important}.home-meal-photos{display:flex;gap:14rpx;margin-bottom:17rpx}.home-meal-photos image{width:118rpx;height:89rpx;border-radius:20rpx;background:#EEE6D8}.home-status{font-size:22rpx;background:#E7EAD6;color:#637556;border-radius:19rpx;padding:6rpx 14rpx;flex-shrink:0}.home-meal-names{font-size:28rpx;margin:3rpx 0 11rpx;line-height:1.8}.tb-meal-empty{display:flex;gap:20rpx;align-items:center}.tb-meal-empty image{width:120rpx;height:120rpx;flex-shrink:0}.home-budget{position:relative;margin-top:36rpx!important}.home-budget:before{content:'';position:absolute;top:-12rpx;right:50rpx;width:95rpx;height:24rpx;background:#F3DCC3;opacity:.85;transform:rotate(5deg)}.tb-summary-foot{border-top:1rpx solid #D6DBC7;padding-top:20rpx;font-size:23rpx;gap:12rpx}.home-pair-link{display:flex!important;align-items:center;justify-content:center;gap:7rpx;font-size:23rpx!important}@media(max-width:350px){.tb-brand{width:195rpx;height:195rpx}.tb-hero .tb-title{font-size:49rpx}.home-shortcut{gap:11rpx;padding:18rpx!important}.home-shortcut-note{font-size:22rpx}.home-order-arrow{font-size:23rpx}.home-subtitle{font-size:22rpx!important}}
