.tb-feedback,.tb-feedback-dog-wrap,.tb-feedback-dog,.tb-feedback-bubble,.tb-feedback-confetti{pointer-events:none}.tb-feedback{position:fixed;right:35rpx;left:35rpx;bottom:calc(145rpx + env(safe-area-inset-bottom));z-index:1500;display:flex;align-items:center;justify-content:center;flex-direction:column;pointer-events:none}.tb-feedback-dog-wrap{height:150rpx;width:170rpx;position:relative;align-self:flex-end;margin-right:12rpx}.tb-feedback-dog{width:100%;height:100%}.tb-feedback-bubble{max-width:100%;box-sizing:border-box;border-radius:28rpx;padding:22rpx 30rpx;background:#4A392E;color:#FFFDF7;font:26rpx/1.6 -apple-system,BlinkMacSystemFont,'Microsoft YaHei',sans-serif;box-shadow:0 6rpx 24rpx #71512c18;animation:bubble-in .18s ease}.celebrate .tb-feedback-dog{animation:dog-pop .6s ease}.greet .tb-feedback-dog{animation:dog-hop .6s ease}.tb-feedback-confetti{position:absolute;width:12rpx;height:19rpx;border-radius:4rpx;background:#C4A273;left:70rpx;top:65rpx;animation:confetti .8s ease-out both}.c1{--tx:-85rpx;--ty:-65rpx}.c2{--tx:65rpx;--ty:-95rpx;background:#A3A16F;animation-delay:.05s}.c3{--tx:-30rpx;--ty:-125rpx;background:#BD91A6;animation-delay:.09s}.c4{--tx:95rpx;--ty:-20rpx;background:#7E9FA5;animation-delay:.04s}@keyframes bubble-in{from{opacity:0;transform:translateY(12rpx)}to{opacity:1;transform:translateY(0)}}@keyframes dog-pop{0%{opacity:.2;transform:translateY(30rpx) scale(.8) rotate(-6deg)}65%{opacity:1;transform:translateY(-6rpx) scale(1.04) rotate(4deg)}100%{opacity:1;transform:none}}@keyframes dog-hop{0%,100%{transform:none}30%{transform:translateY(-17rpx) rotate(-6deg)}65%{transform:translateY(-5rpx) rotate(4deg)}}@keyframes confetti{0%{opacity:0;transform:translate(0,0)}15%{opacity:1}100%{opacity:0;transform:translate(var(--tx),var(--ty)) rotate(180deg)}}@media(prefers-reduced-motion:reduce){.tb-feedback-bubble,.tb-feedback-dog,.tb-feedback-confetti{animation:none!important}.tb-feedback-confetti{display:none}}

