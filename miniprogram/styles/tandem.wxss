.tb-page{padding:30rpx 38rpx 60rpx;box-sizing:border-box;color:var(--text-primary);font-size:28rpx;line-height:1.6;min-height:100vh;background:var(--bg-color)}.tb-between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.tb-title{font-size:43rpx;line-height:1.5;letter-spacing:-1rpx;font-weight:500;margin:12rpx 0}.tb-heading{font-size:31rpx;font-weight:500}.tb-muted{font-size:24rpx;color:var(--text-secondary);line-height:1.7}.tb-eyebrow{font-size:19rpx;letter-spacing:4rpx;color:var(--primary-color);margin-bottom:8rpx}.tb-hero{display:flex;justify-content:space-between;align-items:center;gap:12rpx;padding:35rpx 0}.tb-hero>view{flex:1;min-width:0}.tb-brand{width:270rpx;height:270rpx;border-radius:45rpx;flex-shrink:0}.tb-sticker{width:160rpx;height:160rpx;flex-shrink:0}.tb-card{background:var(--card-bg);border:1rpx solid var(--border-color);border-radius:40rpx;padding:32rpx;margin:22rpx 0}.tb-mint{background:var(--primary-light);border-color:var(--primary-light)}.tb-big-money{font-size:64rpx;font-weight:500;letter-spacing:-2rpx;line-height:1.6;margin:5rpx 0 20rpx;font-variant-numeric:tabular-nums}.tb-chip{font-size:23rpx;line-height:1.5;max-width:390rpx;white-space:normal;background:var(--primary-light);color:var(--primary-dark);border-radius:30rpx;padding:12rpx 18rpx;margin:0}.tb-btn{font-size:29rpx;line-height:1.6;background:var(--primary-color);color:var(--card-bg);border-radius:28rpx;padding:23rpx 25rpx;margin:18rpx 0;text-align:center;min-height:88rpx;box-sizing:border-box}.tb-btn-light{background:var(--card-bg);color:var(--primary-dark);border:1rpx solid var(--border-color)}.tb-text-btn{display:block;margin:0;padding:16rpx 0;min-height:70rpx;background:transparent;font-size:24rpx;line-height:1.6;color:var(--primary-dark);text-align:center}.tb-full{width:100%}.tb-actions{display:flex;gap:18rpx}.tb-actions button{flex:1}.tb-page-actions{padding:15rpx 30rpx}.tb-tabs{display:flex;background:#eee7dc;border-radius:28rpx;padding:8rpx;margin:28rpx 0;gap:8rpx}.tb-tabs button{flex:1;background:transparent;font-size:26rpx;line-height:1.7;padding:16rpx 0;border-radius:22rpx;color:var(--text-secondary)}.tb-tabs .active{background:var(--card-bg);color:var(--primary-dark)}.tb-empty{padding:50rpx 20rpx;display:flex;flex-direction:column;align-items:center;gap:22rpx;color:var(--text-secondary);font-size:27rpx}.tb-empty image{width:200rpx;height:200rpx}.tb-caption{font-size:23rpx;color:var(--text-secondary);text-align:center;margin:25rpx 0;line-height:1.8}.tb-check{display:flex;align-items:center;gap:10rpx;padding:15rpx 0;font-size:25rpx}.tb-danger,.tb-error{color:#a3473b}.tb-error{font-size:26rpx;padding:20rpx;border-radius:22rpx;background:#f8e7dc;margin:20rpx 0;word-break:break-all}.tb-footer-art{display:flex;align-items:center;justify-content:center;gap:18rpx;color:var(--text-secondary);font-size:23rpx;padding:20rpx 0}.tb-footer-art image{width:130rpx;height:130rpx}
.tb-title,.tb-heading{font-family:'TandemCheer','YouYuan','Microsoft YaHei',sans-serif;font-weight:400}.tb-page button.tb-btn.tb-full{width:100%;max-width:none;display:block}.tb-btn,button,.tb-card{transition:transform .16s ease,background-color .18s ease}.tb-btn:active,button:active{transform:scale(.96)}.tb-card:active{transform:scale(.992)}.tb-enter{animation:tb-rise .28s ease}.tb-kitchen-tabs{display:flex;gap:6rpx;padding:7rpx;border-radius:28rpx;background:#eee7dc;margin:10rpx 0 20rpx}.tb-kitchen-tabs>view{flex:1;text-align:center;padding:18rpx 4rpx;border-radius:22rpx;font-size:26rpx;color:var(--text-secondary);transition:background .2s ease,transform .15s ease}.tb-kitchen-tabs .active{background:var(--card-bg);color:var(--primary-dark)}.tb-kitchen-tabs>view:active{transform:scale(.97)}@keyframes tb-rise{from{opacity:.4;transform:translateY(15rpx)}to{opacity:1;transform:translateY(0)}}@keyframes tb-pick{0%{transform:scale(.88)}70%{transform:scale(1.04)}100%{transform:scale(1)}}@media(prefers-reduced-motion:reduce){.tb-enter,.tb-btn,button,.tb-card,.dish-check{animation:none!important;transition:none!important}}
.tb-skeleton{padding:30rpx 0}.tb-skeleton>view{height:100rpx;margin:18rpx 0;background:#eee7da;border-radius:30rpx}.tb-skeleton>view:first-child{height:180rpx;background:#e6eddf}.tb-skeleton>view:last-child{width:65%;height:40rpx}
