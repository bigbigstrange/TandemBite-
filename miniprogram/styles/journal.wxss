page .remark-title,page .success-title,page .cart-panel-title{font-family:'TandemCheer','YouYuan',sans-serif;font-weight:400;color:#4A392E}
page .remark-input{background:#FFFDF7;color:#4A392E;border:1rpx solid #E9DDCA;border-radius:25rpx;font-family:-apple-system,BlinkMacSystemFont,'Microsoft YaHei',sans-serif}
page .success-image{animation:journal-dog .6s ease}
page .tb-filter-categories button>.tb-line-icon{display:block;margin:0 auto 7rpx}
page .search-box>.tb-line-icon,page .search-bar>.tb-line-icon{margin-right:13rpx}
page button{transition:transform .15s ease,background-color .18s ease}
page button:active{transform:scale(.98)}
@keyframes journal-star{0%{transform:scale(.8)}60%{transform:scale(1.12)}100%{transform:scale(1)}}
@keyframes journal-dog{0%{opacity:.3;transform:translateY(24rpx) rotate(-5deg) scale(.85)}70%{opacity:1;transform:translateY(-7rpx) rotate(4deg) scale(1.03)}100%{opacity:1;transform:none}}
@keyframes journal-sheet{from{opacity:.6;transform:translateY(40rpx)}to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){page button,page .success-image,page .tb-filter-sheet,page .tb-unified .tb-favorite.is-favorite{animation:none!important;transition:none!important}}
@media(max-width:350px){page .tb-unified .home-dog{width:195rpx}}
@media(max-width:350px){page .tb-unified .tb-muted,page .tb-unified .tb-caption,page .tb-unified .tb-entry-main>.tb-muted{font-size:11px}page .tb-unified .home-subtitle{font-size:11px!important}}
